# 🐝 DreamBees Discord Bot Configuration Template
# Format: KEY=VALUE (No spaces around '=')

# --- 🤖 Discord Identity ---
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_id_here
DREAMBEES_GUILD_ID=your_guild_id_here

# --- 🍯 DreamBees Backend API ---
DREAMBEES_API_URL=https://dreambeesai.com/api
DREAMBEES_API_KEY=your_api_key_here
WEBAPP_URL=https://dreambeesai.com
GLOBAL_API_CONCURRENCY=50

# --- 🔥 Firebase / Google Cloud ---
GCLOUD_PROJECT=your-project-id

# Option 1: Path to JSON file (Local Dev)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 2: Full JSON string (Cloud Run / GCE)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# Option 3: Web SDK Auth (Admin User Fallback - Used if Service Accounts are blocked)
# Copy these from your DreamBees Frontend settings
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_AUTH_EMAIL=admin@yourproject.com
FIREBASE_AUTH_PASSWORD=your_secure_password_here

# --- 🛰️ Google Cloud Tasks (Generation Queue) ---
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=bot-generation-queue
TASK_WEBHOOK_URL=https://your-bot-url.com/tasks/process-generation
CLOUD_TASKS_SA_EMAIL=task-invoker@your-project-id.iam.gserviceaccount.com

# --- 📦 Storage (Backblaze B2 / S3) ---
B2_ENDPOINT=your_endpoint.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=your_bucket_name
B2_KEY_ID=your_key_id
B2_APP_KEY=your_app_key
B2_PUBLIC_URL=https://cdn.yourdomain.com

# --- 🛡️ Moderation & Logging ---
MODERATOR_LOG_CHANNEL_ID=your_moderator_channel_id_here
NODE_ENV=production
LOG_LEVEL=INFO

# --- 🛰️ External AI & Infrastructure ---
OPENROUTER_API_KEY=sk-or-v1-your_key_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_token_here
GOOGLE_API_KEY=your_google_ai_key_here

# Modal AI Endpoints (Sovereign Pillars)
MODAL_SDXL_ENDPOINT=https://your-modal-sdxl-endpoint.modal.run
MODAL_ZIT_ENDPOINT=https://your-modal-zit-endpoint.modal.run
MODAL_FLUX_ENDPOINT=
