# 🐝 DreamBees Discord Bot Configuration Template
# Format: KEY=VALUE (No spaces around '=')

# --- 🤖 Discord Identity ---
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_id_here
DREAMBEES_GUILD_ID=1275879277895745536

# --- 🍯 DreamBees Backend API ---
DREAMBEES_API_URL=https://dreambeesai.com/api
DREAMBEES_API_KEY=your_api_key_here
WEBAPP_URL=https://dreambeesai.com
GLOBAL_API_CONCURRENCY=50

# --- 🔥 Firebase / Google Cloud ---
GCLOUD_PROJECT=dreambees-alchemist
# Option 1: Path to JSON file (Local Dev)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Option 2: Full JSON string (Cloud Run / GCE)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# --- 📦 Storage (Backblaze B2 / S3) ---
B2_ENDPOINT=your_endpoint.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=your_bucket_name
B2_KEY_ID=your_key_id
B2_APP_KEY=your_app_key
B2_PUBLIC_URL=https://f000.backblazeb2.com

# --- 🛡️ Moderation & Logging ---
MODERATOR_LOG_CHANNEL_ID=your_moderator_channel_id_here
NODE_ENV=production

# Modal AI Endpoints
MODAL_SDXL_ENDPOINT=https://your-modal-sdxl-endpoint.modal.run
MODAL_ZIT_ENDPOINT=https://your-modal-zit-endpoint.modal.run
MODAL_FLUX_ENDPOINT=https://your-modal-flux-endpoint.modal.run
